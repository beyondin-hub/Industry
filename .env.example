# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (membresías de proveedores) ─────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── Twilio (WhatsApp notificaciones) ───────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Resend (email: CFDI, cotizaciones) ─────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=cotizaciones@mrolink.mx

# ─── Claude API (asistente de compras) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ─── EnvíaYa (paquetería multi-carrier) ─────────────────────
ENVIAYA_API_KEY=
ENVIAYA_ACCOUNT_ID=
ENVIAYA_WEBHOOK_SECRET=

# ─── Vercel Cron (protección de endpoints programados) ──────
CRON_SECRET=

# ─── CFDI 4.0 (PAC: Facturama / SW sapien) ──────────────────
PAC_API_URL=
PAC_API_KEY=

# ─── Seguridad admin (2FA TOTP) ─────────────────────────────
ADMIN_2FA_ENABLED=false

# ─── Monitoreo de errores (Sentry-compatible / webhook) ─────
SENTRY_DSN=
MONITORING_WEBHOOK_URL=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
